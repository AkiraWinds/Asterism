<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asterism.frontend</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NPM_BIN__</string>
        <string>run</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/frontend</string>

    <!-- `next start` serves the .next/ production build — it does not build
         on the fly. Run `npm run build` in frontend/ at least once before
         loading this service, and again after any frontend code change
         (this service does not hot-reload). See README.md setup steps. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/asterism-frontend.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/asterism-frontend.log</string>
</dict>
</plist>
