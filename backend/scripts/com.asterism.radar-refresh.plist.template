<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asterism.radar-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>__REPO_ROOT__/backend/scripts/radar_refresh.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ASTERISM_DATA_ROOT</key>
        <string>__ASTERISM_DATA_ROOT__</string>
    </dict>

    <!-- Runs once daily at 08:00. launchd (unlike cron) fires missed runs on
         next wake if the machine was asleep at the scheduled time, so this
         still fires reliably on a laptop that isn't always powered on. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/asterism-radar-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/asterism-radar-refresh.log</string>
</dict>
</plist>
